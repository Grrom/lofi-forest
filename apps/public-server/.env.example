# Host and port for the WebSocket server process inside the container
PORT=8080
HOST=0.0.0.0

# Docker host bind address for port 8080 (127.0.0.1 for local/tunnel/reverse proxy, 0.0.0.0 for direct public access)
LOBBY_BIND=127.0.0.1

# Room capacity and rate limits
MAX_PLAYERS=50
MAX_SPECTATORS=20
MAX_CONN_PER_IP=3

# Comma-separated list of allowed Origin headers (empty allows all origins)
ALLOWED_ORIGINS=

# Comma-separated list of banned IP addresses
BANNED_IPS=

# Trust CF-Connecting-IP header (1 = enabled, 0 = disabled)
# WARNING: Keep 0 when exposing directly on an IP. Only set to 1 when behind Cloudflare proxy/tunnel.
TRUST_CF_HEADER=0

# Cloudflare Realtime TURN credentials for P2P rooms (leave empty to disable /turn endpoint)
TURN_KEY_ID=
TURN_KEY_API_TOKEN=
